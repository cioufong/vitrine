    "Reserved for this VM by the network's DHCP server; pick an address in %@ other than %@ (the Mac).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Reserved for this VM by the network's DHCP server; pick an address in %1$@ other than %2$@ (the Mac)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークの DHCP サーバがこの仮想マシン用に予約します。%@ の範囲で、%@（Mac）以外のアドレスを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由网络的 DHCP 服务器为这台虚拟机保留；请选择 %@ 内的地址，但不要用 %@（Mac 本身）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由網路的 DHCP 伺服器為這台虛擬機器保留；請選擇 %@ 內的位址，但不要用 %@（Mac 本身）。"
          }
        }
      }
    },
