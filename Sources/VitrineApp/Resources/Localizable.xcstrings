          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在虛擬機器內允許 Vitrine Agent"
          }
        }
      }
    },
    "Allow Vitrine under System Settings ▸ General ▸ Login Items.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」▸「一般」▸「ログイン項目」で Vitrine を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置 ▸ 通用 ▸ 登录项”中允许 Vitrine。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定 ▸ 一般 ▸ 登入項目」中允許 Vitrine。"
          }
        }
      }
    },
