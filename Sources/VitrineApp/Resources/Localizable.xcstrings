        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        }
      }
    },
    "Stops idle sleep, which would freeze running guests and drop their network connections. The display can still sleep.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドル時のスリープを防止します。スリープすると実行中のゲストが停止し、ネットワーク接続が切断されます。ディスプレイはスリープできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止闲置睡眠，以免运行中的客户机被冻结并断开网络连接。显示器仍可进入睡眠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止閒置睡眠，否則執行中的客體系統會凍結並中斷網路連線。顯示器仍可進入睡眠。"
          }
        }
      }
    },
    "Subnet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブネット"
          }
        },
        "zh-Hans": {
