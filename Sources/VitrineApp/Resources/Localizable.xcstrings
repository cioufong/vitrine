            "value": "以復原模式啟動"
          }
        }
      }
    },
    "Start the VM and wait for the agent to connect.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシンを起動し、エージェントが接続するまでお待ちください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请启动虚拟机并等待代理连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動虛擬機器並等待 Vitrine Agent 連線。"
          }
        }
      }
    },
    "Start when Vitrine opens": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrine を開いたときに起動"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrine 打开时启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitrine 打開時啟動"
          }
        }
      }
    },
    "Started from the command line (pid %d). Stop it there, or with `vitrinectl stop %@`.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Started from the command line (pid %1$d). Stop it there, or with `vitrinectl stop %2$@`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインから起動されました（pid %d）。そこで停止するか、`vitrinectl stop %@` で停止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从命令行启动（pid %d）。请在命令行中停止，或使用 `vitrinectl stop %@`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從命令列啟動（pid %d）。請在該處停止，或使用 `vitrinectl stop %@`。"
          }
        }
      }
    },
    "Starting Bluetooth…": {
      "localizations": {
