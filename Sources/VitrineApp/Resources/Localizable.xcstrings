    "%@ still use “%@”. Move them to another network first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ still use “%2$@”. Move them to another network first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が「%@」を使用中です。先に別のネットワークに移してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在使用“%@”。请先将它们移到其他网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在使用「%@」。請先將它們移到其他網路。"
          }
        }
      }
    },
