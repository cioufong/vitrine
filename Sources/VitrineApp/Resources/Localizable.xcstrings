        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首次启动时创建，无需经过设置助理。系统会自动登录并启用 SSH，以便 Vitrine 安装 Vitrine Agent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "於第一次開機時建立，不經過「設定輔助程式」。會自動登入並啟用 SSH，讓 Vitrine 可以安裝 Vitrine Agent。"
