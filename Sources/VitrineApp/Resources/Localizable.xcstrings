    },
    "Windows 11 on Arm — near-native speed; runs most x64 apps via Prism": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 on Arm — ネイティブに近い速度。Prism によりほとんどの x64 アプリが動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 on Arm — 接近原生速度；通过 Prism 运行大多数 x64 应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 on Arm — 接近原生速度；可透過 Prism 執行大多數 x64 App"
          }
        }
      }
    },
    "Windows 11 x64 — full emulation, much slower": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 x64 — 完全エミュレーション、大幅に低速"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 x64 — 完全模拟，速度慢得多"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 11 x64 — 完整模擬，速度慢很多"
          }
        }
      }
    },
    "Windows installs unattended with this local account, skips the out-of-box setup and signs in automatically.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows はこのローカルアカウントで無人インストールされ、初期セットアップを省略して自動的にサインインします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 将使用此本地账户进行无人值守安装，跳过开箱设置并自动登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 會使用此本機帳號自動安裝，略過首次開機設定並自動登入。"
          }
        }
      }
    },
    "Your Mac has %lld cores.": {
      "localizations": {
        "ja": {
          "stringUnit": {
