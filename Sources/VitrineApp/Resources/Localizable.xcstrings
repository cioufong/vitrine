    "Allow Vitrine Agent in both prompts in the VM. It then restarts by itself to use them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシン内の 2 つの確認で Vitrine Agent を許可してください。許可後、自動的に再起動して使えるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在虚拟机内的两个提示中允许 Vitrine Agent。之后它会自行重新启动并开始使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在虛擬機器內的兩個提示中允許 Vitrine Agent。之後它會自行重新啟動並開始使用。"
          }
        }
      }
    },
    "Allow Vitrine Agent in the VM": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシン内で Vitrine Agent を許可"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
